{
  "id": null,
  "uid": "spartan-lab1-ops",
  "title": "Spartan Lab 1 - Live RED, FinOps & DB Telemetry",
  "tags": ["spartan", "sre", "finops"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API Request Rate (RPS) by Path & Status",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (path, status) (rate(spartan_http_requests_total[1m]))",
          "legendFormat": "{{path}} [{{status}}]"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API Tail Latency (p50 vs p95 vs p99 Seconds)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(spartan_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(spartan_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(spartan_http_request_duration_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "FinOps: Ingested Cost Burn Rate ($/min by Tenant)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(spartan_event_cost_usd_total[1m])) * 60",
          "legendFormat": "tenant {{tenant_id}} ($/min)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "PostgreSQL Active Connections & Locks",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (state) (pg_stat_activity_count{datname=\"spartan_lab\"})",
          "legendFormat": "pg {{state}}"
        },
        {
          "expr": "sum(pg_locks_count{datname=\"spartan_lab\"})",
          "legendFormat": "total locks"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Events Ingested vs Duplicates Ignored (Idempotency)",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(spartan_events_ingested_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Redis Memory & Connected Clients",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "redis_connected_clients",
          "legendFormat": "clients"
        },
        {
          "expr": "redis_memory_used_bytes / 1024 / 1024",
          "legendFormat": "mem (MB)"
        }
      ]
    }
  ]
}
