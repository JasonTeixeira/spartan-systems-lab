FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    dnsutils \
    htop \
    iproute2 \
    iputils-ping \
    jq \
    lsof \
    netcat-openbsd \
    postgresql-client \
    procps \
    redis-tools \
    strace \
    sysstat \
    tcpdump \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
