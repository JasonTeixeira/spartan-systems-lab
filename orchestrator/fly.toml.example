# Example Fly.io / Dedicated Host config for the Spartan Cloud Sandbox Orchestrator
app = "spartan-sandbox-orchestrator"
primary_region = "iad"

[build]
  dockerfile = "orchestrator/Dockerfile"

[env]
  SPARTAN_SANDBOX_BACKEND = "docker"
  SPARTAN_TERMINAL_WS_URL = "wss://sandbox.sageideas.dev/ws"

[http_service]
  internal_port = 8090
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1

[[vm]]
  cpu_kind = "shared"
  cpus = 2
  memory_mb = 2048
